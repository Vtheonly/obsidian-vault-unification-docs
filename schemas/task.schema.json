{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent Project Task",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "status",
    "inputs",
    "outputs",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,8}-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "ready",
        "in_progress",
        "blocked",
        "review_required",
        "completed"
      ]
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "forbidden_side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional cross-session context. Added by ADR-0006; does not affect task state semantics."
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
