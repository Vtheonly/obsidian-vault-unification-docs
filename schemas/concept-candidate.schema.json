{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emergent Concept Candidate / Knowledge-Gap Record",
  "$id": "https://github.com/Vtheonly/obsidian-vault-unification-docs/schemas/concept-candidate.schema.json",
  "version": "1.0",
  "type": "object",
  "required": [
    "candidate_id",
    "term",
    "proposed_title",
    "kind",
    "status",
    "evidence",
    "independent_contexts",
    "definition_evidence",
    "gap_description",
    "destination_recommendation",
    "destination_rationale",
    "confidence",
    "coverage",
    "verification_criteria",
    "decision_history"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^CG-[0-9a-f]{12}$",
      "description": "Content-derived stable id: sha256 over the term and sorted evidence ku_ids (deterministic; identical inputs regenerate identical ids)."
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "description": "The mined term/phrase the candidate is grounded in (casefolded surface form)."
    },
    "proposed_title": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic human-readable proposal derived from the term; semantic review may revise it."
    },
    "kind": {
      "type": "string",
      "enum": [
        "unexplained_prerequisite",
        "fragmented_derivation",
        "rare_essential",
        "concept_sighting"
      ],
      "description": "unexplained_prerequisite = used across independent contexts, never adequately explained; fragmented_derivation = derivation-flavored usage spread across notes without a coherent treatment; rare_essential = single-context usage in a dependency position (assumed / inside a derivation), no frequency threshold; concept_sighting = usage with adequate explanation found elsewhere (negative evidence, status already_covered)."
    },
    "status": {
      "type": "string",
      "enum": [
        "provisional_candidate",
        "already_covered",
        "confirmed_gap",
        "accepted",
        "rejected",
        "deferred",
        "merged",
        "split"
      ],
      "description": "discover-gaps emits ONLY provisional_candidate or already_covered. confirmed_gap/accepted/rejected/deferred/merged/split are review decisions (discovery-decide) with history. confirmed_gap requires coverage.coverage_complete = true (enforced by discovery-validate)."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ku_id",
          "vault",
          "source_path",
          "line_start",
          "line_end",
          "relationship",
          "quote"
        ],
        "properties": {
          "ku_id": {
            "type": "string",
            "minLength": 1
          },
          "vault": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "relationship": {
            "type": "string",
            "enum": [
              "defined",
              "declared",
              "used",
              "assumed",
              "derivation"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Machine-located byte-accurate excerpt (whitespace-normalized matching per the locator; unique-occurrence rule for line attribution)."
          }
        }
      }
    },
    "independent_contexts": {
      "type": "integer",
      "minimum": 1,
      "description": "Distinct (source file, passage) contexts after collapsing near-identical copied passages; a repeated mention in one copied passage is NOT independent recurrence."
    },
    "copied_passage": {
      "type": "boolean",
      "description": "True when some evidence passages were byte/whitespace-identical across files and were collapsed."
    },
    "definition_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ku_id",
          "vault",
          "source_path",
          "line_start",
          "line_end",
          "relationship",
          "quote"
        ],
        "properties": {
          "ku_id": {
            "type": "string"
          },
          "vault": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "relationship": {
            "type": "string",
            "enum": [
              "defined",
              "declared"
            ]
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "description": "Definition/declaration occurrences found anywhere in the processed corpus (empty for gap candidates)."
    },
    "homonym_suspect": {
      "type": "boolean",
      "description": "True when the term's contexts split into clusters with disjoint co-occurrence signatures; the candidate must NOT be auto-merged across senses (F-0008 mAP precedent)."
    },
    "homonym_clusters": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "context_files",
          "signature_terms"
        ],
        "properties": {
          "cluster_id": {
            "type": "integer"
          },
          "context_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signature_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contradiction_suspect": {
      "type": "boolean"
    },
    "contradictions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "a_ku_id",
          "b_ku_id",
          "note"
        ],
        "properties": {
          "a_ku_id": {
            "type": "string"
          },
          "b_ku_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Pairs of contexts carrying different numeric claims adjacent to the term; surfaced, never silently resolved (F-0009 pattern)."
    },
    "gap_description": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic machine description of the specific gap/fragmentation being evidenced, with counts and denominators."
    },
    "destination_recommendation": {
      "type": "string",
      "enum": [
        "standalone_note_candidate",
        "section_candidate",
        "no_gap",
        "undecided"
      ],
      "description": "Deterministic hint from evidence breadth; semantic review owns the final destination decision."
    },
    "destination_rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "object",
      "required": [
        "score",
        "signals"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Deterministic signal composite; NOT a semantic verdict."
        },
        "signals": {
          "type": "object",
          "description": "Named boolean/integer signals composing the score (independent_contexts, assumed_usages, derivation_usages, definition_count, homonym_suspect, copied_passage)."
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "vaults",
        "coverage_complete"
      ],
      "properties": {
        "vaults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "vault",
              "processed_files",
              "total_files"
            ],
            "properties": {
              "vault": {
                "type": "string"
              },
              "processed_files": {
                "type": "integer",
                "minimum": 0
              },
              "total_files": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "coverage_complete": {
          "type": "boolean",
          "description": "True only when every declared vault has processed_files == total_files. When false, gap statuses CANNOT be confirmed (hard gate)."
        }
      }
    },
    "verification_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Checks the accepted concept must eventually pass (dossier coverage, dependent links, no duplicate canonical content)."
    },
    "decision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "action",
          "rationale",
          "reviewer",
          "decided_utc"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "confirm_gap",
              "accept",
              "reject",
              "defer",
              "merge",
              "split",
              "revise",
              "cover"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "decided_utc": {
            "type": "string",
            "description": "ISO-8601 UTC timestamp; decisions are events, not deterministic artifacts."
          },
          "merge_into": {
            "type": "string",
            "description": "Target candidate_id for merge actions (provenance preserved in history)."
          },
          "split_into": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "New candidate_ids for split actions."
          },
          "revised_title": {
            "type": "string"
          },
          "revised_scope": {
            "type": "string"
          }
        }
      },
      "description": "Append-only review history; merge/split preserve provenance by reference."
    }
  }
}
